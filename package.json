{
  "name": "codeboard-studio",
  "version": "0.3.0",
  "description": "Code-first drawing and storyboard tools for JavaScript and TypeScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonomnonom/codeboard.git"
  },
  "homepage": "https://github.com/nonomnonom/codeboard#readme",
  "bugs": {
    "url": "https://github.com/nonomnonom/codeboard/issues"
  },
  "keywords": [
    "storyboard",
    "animation",
    "drawing",
    "procedural-art",
    "typescript",
    "brush-engine"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "codeboard": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:package": "node scripts/verify-package.mjs",
    "test:install": "node scripts/verify-package.mjs --install",
    "typecheck": "tsc --noEmit",
    "docs:generate": "node scripts/build-api-docs.mjs && node plugin/scripts/sync-reference.mjs",
    "check:docs": "node scripts/build-api-docs.mjs --check && node scripts/check-doc-links.mjs",
    "check:plugin": "node plugin/scripts/sync-reference.mjs --check && node plugin/scripts/check.mjs && node plugin/evals/test-reference-sync.mjs",
    "prepack": "npm run build",
    "example:quickstart": "codeboard run examples/quickstart.mjs",
    "check": "npm run build && npm test && npm run check:docs && npm run check:plugin && npm run test:package",
    "example": "codeboard run examples/last-light.ts",
    "example:movie": "codeboard run examples/last-light.ts --movie",
    "example:revise": "codeboard run examples/revise-last-light.ts",
    "example:lengkap": "codeboard run examples/lengkap.ts",
    "example:lengkap:movie": "codeboard run examples/lengkap.ts --movie",
    "example:lengkap:verify": "codeboard run examples/lengkap/verify.ts",
    "preview": "codeboard preview examples/output/last-light/last-light.cboard",
    "verify": "npm run build && npm test && npm run example",
    "demo:typecheck": "tsc -p code-board-demo/tsconfig.json",
    "demo:author": "codeboard run code-board-demo/src/run.ts author",
    "demo:verify": "codeboard run code-board-demo/src/run.ts verify",
    "demo:render": "codeboard run code-board-demo/src/run.ts render",
    "demo:review-script": "codeboard run code-board-demo/src/run.ts review-script",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund && node scripts/sync-release-version.mjs && npm run docs:generate",
    "docs:assets": "npm run build && node scripts/build-guide-assets.mjs"
  },
  "engines": {
    "node": ">=22.22"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "sharp": "^0.35.5",
    "skia-canvas": "^3.0.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.7.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
