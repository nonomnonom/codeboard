{
  "name": "codeboard-studio",
  "version": "1.1.0",
  "description": "Code-first drawing and storyboard tools for JavaScript and TypeScript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nonomnonom/codeboard.git"
  },
  "homepage": "https://github.com/nonomnonom/codeboard#readme",
  "bugs": {
    "url": "https://github.com/nonomnonom/codeboard/issues"
  },
  "keywords": [
    "storyboard",
    "animation",
    "drawing",
    "procedural-art",
    "typescript",
    "brush-engine"
  ],
  "license": "MIT",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./three": {
      "types": "./dist/src/three.d.ts",
      "import": "./dist/src/three.js"
    }
  },
  "bin": {
    "codeboard": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "dist/docs",
    "NOTICE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "vitest run --project unit --project integration --project e2e",
    "test:unit": "vitest run --project unit",
    "test:mutation": "stryker run",
    "test:integration": "npm run build && vitest run --project integration",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:media": "npm run build && vitest run --project media",
    "test:all": "npm run build && vitest run",
    "test:coverage": "npm run build && vitest run --project unit --project integration --project e2e --coverage",
    "test:package": "npm run build && node scripts/verify-package.mjs",
    "test:install": "npm run build && node scripts/verify-package.mjs --install",
    "test:studies:install": "npm run build && node scripts/verify-studies-install.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "docs:generate": "node scripts/build-api-docs.mjs",
    "check:docs": "node scripts/build-api-docs.mjs --check && node scripts/check-doc-links.mjs",
    "check:plugin": "npm run plugin:build && node plugin/scripts/sync-reference.mjs --check && node plugin/scripts/check.mjs && node plugin/evals/test-reference-sync.mjs",
    "prepack": "npm run build && npm run check:docs && npm run docs:bundle",
    "example:quickstart": "npm run quickstart:author --workspace @codeboard/examples",
    "check": "npm run build && npm run lint && npm run format:check && npm run check:architecture && npm run workspaces:check && npm run examples:typecheck && vitest run --project unit --project integration --project e2e && npm run check:docs && npm run check:plugin",
    "example": "npm run last-light:author --workspace @codeboard/examples",
    "example:movie": "npm run last-light:render --workspace @codeboard/examples -- --movie",
    "example:revise": "npm run last-light:revise --workspace @codeboard/examples",
    "example:lengkap": "npm run lengkap:author --workspace @codeboard/examples",
    "example:lengkap:movie": "npm run lengkap:render --workspace @codeboard/examples -- --movie",
    "example:lengkap:verify": "npm run lengkap:verify --workspace @codeboard/examples",
    "preview": "node dist/src/cli.js preview examples/last-light/output/last-light.cboard",
    "verify": "npm test && npm run example",
    "demo:typecheck": "npm run typecheck --workspace @codeboard/examples",
    "demo:author": "npm run code-board-demo:presentation:author --workspace @codeboard/examples",
    "demo:verify": "npm run code-board-demo:presentation:verify --workspace @codeboard/examples",
    "demo:render": "npm run code-board-demo:presentation:render --workspace @codeboard/examples",
    "demo:review-script": "npm run code-board-demo:presentation:review-script --workspace @codeboard/examples",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts --no-audit --no-fund && node scripts/sync-release-version.mjs && npm run docs:generate",
    "docs:assets": "npm run build && node scripts/build-guide-assets.mjs",
    "dev": "tsc --watch --preserveWatchOutput",
    "examples:typecheck": "npm run typecheck --workspace @codeboard/examples",
    "workspaces:check": "node scripts/check-workspaces.mjs",
    "example:studies": "npm run studies:author --workspace @codeboard/examples",
    "example:character": "npm run code-board-demo:author --workspace @codeboard/examples",
    "website:dev": "npm run dev --workspace codeboard-website",
    "website:build": "npm run build --workspace codeboard-website",
    "test:watch": "vitest --project unit --project integration",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:architecture": "node scripts/check-architecture.mjs",
    "plugin:build": "node plugin/scripts/sync-reference.mjs",
    "docs:bundle": "node scripts/build-docs-index.mjs"
  },
  "engines": {
    "node": ">=22.22"
  },
  "dependencies": {
    "@types/three": "0.186.0",
    "@xmldom/xmldom": "0.9.12",
    "commander": "^14.0.1",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "sharp": "^0.35.5",
    "skia-canvas": "^3.0.8",
    "three": "0.186.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "^3.0.3",
    "@stryker-mutator/core": "10.0.0",
    "@types/node": "^24.7.0",
    "@vitest/coverage-v8": "4.1.11",
    "github-slugger": "^2.0.0",
    "remark": "^15.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "overrides": {
    "typed-rest-client": {
      "qs": "6.16.0"
    }
  },
  "workspaces": [
    ".",
    "examples",
    "website"
  ]
}
