{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "coverageAnalysis": "off",
  "commandRunner": {
    "command": "node node_modules/vitest/vitest.mjs run --project unit test/unit/rational-time.test.ts test/unit/pixel-buffer.test.ts test/unit/pixel-comparison.test.ts"
  },
  "mutate": ["src/animation/rational-time.ts", "src/drawing/pixel-buffer.ts"],
  "concurrency": 2,
  "thresholds": { "high": 90, "low": 85, "break": 85 },
  "tempDirName": ".preview/stryker",
  "ignorePatterns": [
    ".preview/**",
    "dist/**",
    "website/**",
    "plugin/**",
    "examples/**",
    "docs/**",
    "design/**",
    "release/**",
    "coverage/**"
  ],
  "reporters": ["clear-text", "html", "json"],
  "htmlReporter": { "fileName": "coverage/mutation/index.html" },
  "jsonReporter": { "fileName": "coverage/mutation/mutation.json" }
}
